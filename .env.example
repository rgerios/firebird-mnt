# Portas expostas no host Linux (8443 = HTTPS com certificado autoassinado, 8000 = HTTP)
INFRAMGNT_HTTPS_PORT=8443
INFRAMGNT_PORT=8000

# Fuso horário para logs, séries temporais e agendamentos Cron
TZ=America/Sao_Paulo

# Credenciais iniciais do Administrador Total (DBA)
INFRAMGNT_ADMIN_USER=admin
INFRAMGNT_ADMIN_PASSWORD=Venosan@2026

# Senha inicial do usuário Somente Leitura para TV da Sala NOC (usuário: firebird-ro)
INFRAMGNT_RO_PASSWORD=VenosanRO@2026

# Chave secreta para assinatura de sessão HMAC-SHA256
INFRAMGNT_SECRET_KEY=troque-por-uma-chave-aleatoria-segura-em-producao
