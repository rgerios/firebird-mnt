# Porta HTTP exposta no host Linux
INFRAMGNT_PORT=8000

# Fuso horário para logs e agendamentos Cron
TZ=America/Sao_Paulo

# Credenciais iniciais do administrador (criadas no primeiro boot)
INFRAMGNT_ADMIN_USER=admin
INFRAMGNT_ADMIN_PASSWORD=Venosan@2026

# Chave secreta para assinatura de sessão HMAC-SHA256 (troque em produção)
INFRAMGNT_SECRET_KEY=troque-por-uma-chave-aleatoria-segura-em-producao
